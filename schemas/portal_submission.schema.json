{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Direct Hugging Face gene embedding submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "embedding_id",
    "display_name",
    "scientific",
    "provenance",
    "licensing",
    "attestations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "embedding_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160
    },
    "contributor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "affiliation"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2
        },
        "affiliation": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "scientific": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "modality",
        "description"
      ],
      "properties": {
        "category": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "pattern": "^[^\\r\\n]+$",
          "description": "Broad catalog category. Recommended values are defined in config/modalities.yaml. Unrecognized values are published under Other."
        },
        "modality": {
          "type": "string",
          "minLength": 2,
          "description": "Specific free-text modality represented by the embedding."
        },
        "original_method": {
          "type": "string",
          "minLength": 2
        },
        "model_checkpoint": {
          "type": "string",
          "minLength": 1
        },
        "source_publication": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "minLength": 30,
          "maxLength": 2000
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "species",
        "identifier_before_mapping",
        "mapping_method"
      ],
      "properties": {
        "embedding_generated_by": {
          "type": "string",
          "minLength": 2
        },
        "input_data_source": {
          "type": "string",
          "minLength": 2
        },
        "input_data_release": {
          "type": "string",
          "minLength": 1
        },
        "species": {
          "type": "string",
          "minLength": 2
        },
        "pooling_strategy": {
          "type": "string",
          "minLength": 2
        },
        "identifier_before_mapping": {
          "type": "string",
          "minLength": 2
        },
        "mapping_method": {
          "type": "string",
          "minLength": 5
        }
      }
    },
    "licensing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "redistribution_allowed"
      ],
      "properties": {
        "source_license": {
          "type": "string",
          "minLength": 2
        },
        "redistribution_allowed": {
          "const": true
        },
        "terms_url": {
          "type": "string",
          "minLength": 5,
          "format": "uri"
        }
      }
    },
    "attestations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "information_is_accurate",
        "rights_to_redistribute",
        "no_sensitive_human_data",
        "no_patient_level_data",
        "source_terms_reviewed",
        "acceptance_of_automatic_checks"
      ],
      "properties": {
        "information_is_accurate": {
          "const": true
        },
        "rights_to_redistribute": {
          "const": true
        },
        "no_sensitive_human_data": {
          "const": true
        },
        "no_patient_level_data": {
          "const": true
        },
        "source_terms_reviewed": {
          "const": true
        },
        "acceptance_of_automatic_checks": {
          "const": true
        }
      }
    }
  }
}
