{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gene embedding package metadata",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "embedding_id",
    "display_name",
    "species",
    "original_identifier_type",
    "mapping_method",
    "redistribution_allowed"
  ],
  "properties": {
    "embedding_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 3
    },
    "species": {
      "type": "string",
      "minLength": 2
    },
    "broad_modality": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "pattern": "^[^\\r\\n]+$"
    },
    "detailed_modality": {
      "type": "string",
      "minLength": 2
    },
    "original_method": {
      "type": "string",
      "minLength": 2
    },
    "model_checkpoint": {
      "type": "string",
      "minLength": 1
    },
    "embedding_generated_by": {
      "type": "string",
      "minLength": 2
    },
    "input_data_source": {
      "type": "string",
      "minLength": 2
    },
    "input_data_release": {
      "type": "string",
      "minLength": 1
    },
    "pooling_strategy": {
      "type": "string",
      "minLength": 2
    },
    "original_identifier_type": {
      "type": "string",
      "minLength": 2
    },
    "mapping_method": {
      "type": "string",
      "minLength": 5
    },
    "source_license": {
      "type": "string",
      "minLength": 2
    },
    "redistribution_allowed": {
      "const": true
    },
    "source_url": {
      "type": "string"
    },
    "publication": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "pattern": "^[^\\r\\n]+$",
      "description": "Broad catalog category."
    },
    "modality": {
      "type": "string",
      "minLength": 2,
      "description": "Specific free-text embedding modality."
    },
    "description": {
      "type": "string",
      "minLength": 30
    },
    "terms_url": {
      "type": "string",
      "format": "uri"
    },
    "n_genes": {
      "type": "integer",
      "minimum": 1
    },
    "n_dimensions": {
      "type": "integer",
      "minimum": 1
    },
    "dtype": {
      "type": "string",
      "minLength": 1
    },
    "npz_key": {
      "type": "string",
      "minLength": 1
    },
    "master_coverage_fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "validation_outcome": {
      "const": "PASS"
    },
    "accepted_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "metadata_generated_automatically": {
      "const": true
    },
    "contributor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2
        },
        "affiliation": {
          "type": "string",
          "minLength": 2
        },
        "huggingface_username": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "anyOf": [
        {
          "required": [
            "category",
            "modality"
          ]
        },
        {
          "required": [
            "broad_modality",
            "detailed_modality"
          ]
        }
      ],
      "x-category-modality-compatibility": true
    }
  ]
}
